{
  "version": 1,
  "note": "Shorthand that players and the SCPT hosts use for game terms, and the canonical term each stands for. Search adds the canonical term wherever the shorthand appears, in the transcript text when indexing and in the query when searching, so \"Diplo\" and \"Diplomacy\" find the same chunks. Transcripts are never rewritten. Patterns are JavaScript regular expressions, matched case-insensitively. Ambiguous words (\"lead\", \"support\", colours) only match in fixed phrases.",
  "synonyms": [
    {"pattern": "\\bdiplo\\b", "means": "Diplomacy"},
    {"pattern": "\\b(take|took|taking|pick|picked|picking|play|played|playing|with) lead\\b", "means": "Leadership"},
    {"pattern": "\\bimp\\b", "means": "Imperial"},
    {"pattern": "\\b(GD|grav drive|grav)\\b", "means": "Gravity Drive"},
    {"pattern": "\\bAMD\\b", "means": "Antimass Deflectors"},
    {"pattern": "\\bsarween\\b", "means": "Sarween Tools"},
    {"pattern": "\\bfleet log\\b", "means": "Fleet Logistics"},
    {"pattern": "\\bLWD\\b", "means": "Light/Wave Deflector"},
    {"pattern": "\\bduranium\\b", "means": "Duranium Armor"},
    {"pattern": "\\bX[- ]?89\\b", "means": "X-89 Bacterial Weapon"},
    {"pattern": "\\bmagen\\b", "means": "Magen Defense Grid"},
    {"pattern": "\\bgraviton\\b", "means": "Graviton Laser System"},
    {"pattern": "\\bhyper metab\\w*", "means": "Hyper Metabolism"},
    {"pattern": "\\bdacxive\\b", "means": "Dacxive Animators"},
    {"pattern": "\\bcruisers? (2|two)\\b", "means": "Cruiser II"},
    {"pattern": "\\bcarriers? (2|two)\\b", "means": "Carrier II"},
    {"pattern": "\\bdestroyers? (2|two)\\b", "means": "Destroyer II"},
    {"pattern": "\\b(dreadnoughts?|dreads?) (2|two)\\b", "means": "Dreadnought II"},
    {"pattern": "\\bfighters? (2|two)\\b", "means": "Fighter II"},
    {"pattern": "\\binfantry (2|two)\\b", "means": "Infantry II"},
    {"pattern": "\\bPDS (2|two)\\b", "means": "PDS II"},
    {"pattern": "\\b(space )?docks? (2|two)\\b", "means": "Space Dock II"},
    {"pattern": "\\bdreads?\\b", "means": "Dreadnought"},
    {"pattern": "\\bwar ?suns?\\b", "means": "War Sun"},
    {"pattern": "\\b(CCs?|command counters?)\\b", "means": "command token"},
    {"pattern": "\\bTGs?\\b", "means": "trade goods"},
    {"pattern": "\\bcomm(od)?s\\b", "means": "commodities"},
    {"pattern": "\\bPNs?\\b", "means": "promissory note"},
    {"pattern": "\\b(SFT|support for (the )?throne)\\b", "means": "Support for the Throne"},
    {"pattern": "\\bskips?\\b", "means": "technology specialty"},
    {"pattern": "\\bblue (tech|techs|technology|skip|skips|path)\\b", "means": "Propulsion"},
    {"pattern": "\\bgreen (tech|techs|technology|skip|skips|path)\\b", "means": "Biotic"},
    {"pattern": "\\byellow (tech|techs|technology|skip|skips|path)\\b", "means": "Cybernetic"},
    {"pattern": "\\bred (tech|techs|technology|skip|skips|path)\\b", "means": "Warfare technology"},
    {"pattern": "(?<!Mecatol )\\bRex\\b", "means": "Mecatol Rex"},
    {"pattern": "\\bstage (1|one|I) (objective|objectives|public|publics)\\b", "means": "stage I objective"},
    {"pattern": "\\bstage (2|two|II) (objective|objectives|public|publics)\\b", "means": "stage II objective"}
  ]
}
